{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/actelos/cyrnel/main/schema/module-manifest.schema.json",
  "title": "Cyrnel Module Manifest",
  "description": "Schema for cyrnel custom module manifests (module.json)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$",
      "description": "Unique identifier for the module. Must match /^[A-Za-z_$][A-Za-z0-9_$-]*$/."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name for the module."
    },
    "type": {
      "type": "string",
      "enum": ["adapter", "environment"],
      "description": "Module type: 'adapter' (provides tools via external API) or 'environment' (executes user code)."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description surfaced in GET /modules."
    },
    "main": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to the built ESM entry file the host can import()."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version of the module (e.g. '1.2.3')."
    },
    "engines": {
      "type": "object",
      "properties": {
        "cyrnel": {
          "type": "string",
          "description": "Semantic range constraint for Cyrnel core version (e.g. '^1.0.0')."
        }
      },
      "additionalProperties": false,
      "description": "Optional engine constraints."
    }
  },
  "required": ["id", "name", "type", "description", "main", "version"],
  "additionalProperties": false
}
