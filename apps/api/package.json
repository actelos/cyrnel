{
  "name": "@cyrnel/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json -f",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "tsx scripts/generate-definition.ts --out ./openapi.json ../../docs/cyrnel/openapi.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@cyrnel/openapi": "workspace:*",
    "@cyrnel/sdk": "workspace:*",
    "@cyrnel/typescript-ivm": "workspace:*",
    "@libsql/client": "^0.17.3",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.3",
    "express": "^5.2.1",
    "fast-json-patch": "^3.1.1",
    "fzstd": "^0.1.1",
    "ipaddr.js": "^2.4.0",
    "multer": "^2.2.0",
    "openapi3-ts": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "tar": "^7.5.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.3",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@10.30.3"
}
