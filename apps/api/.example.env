# SERVER
PORT=9371
# How long to wait for in-flight requests before forcing shutdown.
SHUTDOWN_TIMEOUT_MS=10000
# Maximum concurrent connections (0 = unlimited).
# CYRNEL_MAX_CONNECTIONS=0
# Keep-alive timeout in ms (default 5000).
# CYRNEL_KEEPALIVE_TIMEOUT_MS=5000
# Headers timeout in ms (default 6000).
# CYRNEL_HEADERS_TIMEOUT_MS=6000
# Request timeout in ms (0 = no timeout).
# CYRNEL_REQUEST_TIMEOUT_MS=0

# LOGGING
# One of: trace | debug | info | warn | error | fatal | silent.
# Defaults to debug in development and info in production.
LOG_LEVEL=info

# AUTH
# If unset, the API runs unauthenticated.
CYRNEL_API_KEY=

# SECRETS
# Primary AES-256-GCM key for encrypting secrets.
# Base64-encoded, must decode to exactly 32 bytes.
# Generate: openssl rand -base64 32
CYRNEL_SECRETS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional: comma-separated base64 keys that can still decrypt existing
# secrets but are no longer used for new encryptions.
# Used during key rotation — set to the old CYRNEL_SECRETS_KEY value
# before replacing CYRNEL_SECRETS_KEY with the new key.
# CYRNEL_SECRETS_PREVIOUS_KEYS=<old-key-in-base64>[,<even-older-key>]

# DATABASE
# If unset, falls back to a local SQLite file in CYRNEL_DATA_DIR.
# file:./mci.db | libsql://<host>?authToken=<token>
CYRNEL_DB_URL=

# STORAGE
# Base dir for SQLite DB and custom modules at <CYRNEL_DATA_DIR>/modules/
CYRNEL_DATA_DIR=./

# REGISTRY EGRESS FIREWALL
# Comma-separated CIDR ranges that are always allowed for registry downloads.
# Matching addresses bypass the default SSRF guard.
# Examples:
#   CYRNEL_REGISTRY_ALLOWED_IPS=10.0.0.0/8
#   CYRNEL_REGISTRY_ALLOWED_IPS=10.0.0.0/8,fd00::/8
CYRNEL_REGISTRY_ALLOWED_IPS=

# Comma-separated CIDR ranges that are always blocked for registry downloads.
# Blocked entries take precedence over allowed entries.
# Examples:
#   CYRNEL_REGISTRY_BLOCKED_IPS=203.0.113.0/24
#   CYRNEL_REGISTRY_BLOCKED_IPS=10.0.0.100/32
CYRNEL_REGISTRY_BLOCKED_IPS=

# Deny all registry downloads unless a resolved address matches
# CYRNEL_REGISTRY_ALLOWED_IPS. Truthy: 1 | true.
CYRNEL_BLOCK_ALL_REGISTRIES=false

# RATE LIMITING
# If unset, rate limiting is disabled.
CYRNEL_RATE_LIMIT_MAX=
CYRNEL_RATE_LIMIT_WINDOW_MS=



# INBOUND ACCESS CONTROL
# Comma-separated CIDR ranges that are always allowed for inbound API access.
# Matching addresses bypass all other checks.
# Examples:
#   CYRNEL_ALLOWED_IPS=10.0.0.0/8
CYRNEL_ALLOWED_IPS=

# Comma-separated CIDR ranges that are always blocked for inbound API access.
# Blocked entries take precedence over allowed entries.
# Examples:
#   CYRNEL_BLOCKED_IPS=203.0.113.0/24
CYRNEL_BLOCKED_IPS=

# PROCESS & SANDBOX LIMITS
# Maximum number of in-memory active process records (default 1000).
# CYRNEL_MAX_ACTIVE_PROCESSES=1000

# Maximum code size in bytes for sandbox execution (default 102400).
# CYRNEL_MAX_CODE_SIZE_BYTES=102400

# Tool invocation timeout in ms (default 30000).
# CYRNEL_INVOKE_TIMEOUT_MS=30000
