# SERVER
PORT=7687
# How long to wait for in-flight requests before forcing shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# LOGGING
# One of: trace | debug | info | warn | error | fatal | silent.
# Defaults to debug in development and info in production.
LOG_LEVEL=info

# AUTH
# If unset, the API runs unauthenticated.
CYRNEL_API_KEY=

# SECRETS
# AES-256-GCM key, base64-encoded, must decode to exactly 32 bytes.
# Generate: openssl rand -base64 32
CYRNEL_SECRETS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# DATABASE
# If unset, falls back to a local SQLite file in CYRNEL_DATA_DIR.
# file:./mci.db | libsql://<host>?authToken=<token>
CYRNEL_DB_URL=

# STORAGE
# Base dir for SQLite DB and custom modules at <CYRNEL_DATA_DIR>/modules/
CYRNEL_DATA_DIR=./

# REGISTRY
# Comma-separated CIDR ranges that are always allowed for registry downloads.
# Matching addresses bypass the default SSRF guard.
# Examples:
#   CYRNEL_ALLOWED_IPS=10.0.0.0/8
#   CYRNEL_ALLOWED_IPS=10.0.0.0/8,fd00::/8
CYRNEL_ALLOWED_IPS=

# Comma-separated CIDR ranges that are always blocked for registry downloads.
# Blocked entries take precedence over allowed entries.
# Examples:
#   CYRNEL_BLOCKED_IPS=203.0.113.0/24
#   CYRNEL_BLOCKED_IPS=10.0.0.100/32
CYRNEL_BLOCKED_IPS=

# Deny all registry downloads unless a resolved address matches
# CYRNEL_ALLOWED_IPS. Truthy: 1 | true.
CYRNEL_BLOCK_ALL_REGISTRIES=false
