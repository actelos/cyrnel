# SERVER
PORT=9371
# How long to wait for in-flight requests before forcing shutdown.
SHUTDOWN_TIMEOUT_MS=10000
# Maximum concurrent connections (0 = unlimited).
# CYRNEL_MAX_CONNECTIONS=0
# Keep-alive timeout in ms (default 5000).
# CYRNEL_KEEPALIVE_TIMEOUT_MS=5000
# Headers timeout in ms (default 6000).
# CYRNEL_HEADERS_TIMEOUT_MS=6000
# Request timeout in ms (0 = no timeout).
# CYRNEL_REQUEST_TIMEOUT_MS=0

# LOGGING
# One of: trace | debug | info | warn | error | fatal | silent.
# Defaults to debug in development and info in production.
LOG_LEVEL=info

# Persistent JSONL log file at <CYRNEL_DATA_DIR>/logs/app.log
# (set to "false" to disable file logging).
# CYRNEL_LOG_FILE=
# Rotate the active file when it reaches this size in MB (default 10).
# CYRNEL_LOG_ROTATION_MB=10
# Keep at most this many rotated files (default 5).
# CYRNEL_LOG_MAX_FILES=5
# In-memory ring buffer of recent entries served by GET /logs (default 10000).
# CYRNEL_LOG_RING_BUFFER=10000
# Dedupe window in ms for identical warn/error messages (0 = disabled).
# CYRNEL_LOG_DEDUPE_WINDOW_MS=0

# AUTH
# If unset, the API runs unauthenticated.
CYRNEL_API_KEY=

# SECRETS
# Primary AES-256-GCM key for encrypting secrets.
# Base64-encoded, must decode to exactly 32 bytes.
# Generate: openssl rand -base64 32
CYRNEL_SECRETS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional: comma-separated base64 keys that can still decrypt existing
# secrets but are no longer used for new encryptions.
# Used during key rotation - set to the old CYRNEL_SECRETS_KEY value
# before replacing CYRNEL_SECRETS_KEY with the new key.
# CYRNEL_SECRETS_PREVIOUS_KEYS=<old-key-in-base64>[,<even-older-key>]

# DATABASE
# If unset, falls back to a local SQLite file in CYRNEL_DATA_DIR.
# file:./data.db | libsql://<host>?authToken=<token>
CYRNEL_DB_URL=

# STORAGE
# Base dir for SQLite DB and custom modules at <CYRNEL_DATA_DIR>/modules/
CYRNEL_DATA_DIR=./

# SEARCH
# Embedding model for hybrid tool search. Must match the embedding dimension
# baked into the tool_embeddings table (384 for bge-small-en-v1.5); changing
# models requires a full tool_embeddings rebuild and re-embedding, even when
# the vector width stays at 384. Downloaded on first startup into
# <CYRNEL_DATA_DIR>/.cache/transformers; if loading fails the API runs in
# FTS5-only search mode for the process lifetime.
CYRNEL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Interval between background search-index reconciliation sweeps (ms).
# A startup sweep always runs; 0 disables the interval. Valid values are
# integers from 0 through 2147483647. Default 1800000.
CYRNEL_RECONCILE_INTERVAL_MS=1800000
# Interval between automatic module/service update sweeps (ms). Items are
# opted in at install (autoUpdate defaults to true) and adjustable per-item
# via POST /modules/:id/auto-update or POST /services/:id/auto-update; a
# startup sweep runs when enabled.
# 0 disables the auto-updater entirely. Valid values are integers from 0
# through 2147483647. Default 0.
CYRNEL_AUTO_UPDATE_INTERVAL_MS=0

# REGISTRY EGRESS FIREWALL
# Comma-separated CIDR ranges that are always allowed for registry downloads.
# Matching addresses bypass the default SSRF guard.
# Examples:
#   CYRNEL_REGISTRY_ALLOWED_IPS=10.0.0.0/8
#   CYRNEL_REGISTRY_ALLOWED_IPS=10.0.0.0/8,fd00::/8
#   CYRNEL_REGISTRY_ALLOWED_IPS=127.0.0.1/32   (local dev fixture, port 9372)
CYRNEL_REGISTRY_ALLOWED_IPS=

# Comma-separated CIDR ranges that are always blocked for registry downloads.
# Blocked entries take precedence over allowed entries.
# Examples:
#   CYRNEL_REGISTRY_BLOCKED_IPS=203.0.113.0/24
#   CYRNEL_REGISTRY_BLOCKED_IPS=10.0.0.100/32
CYRNEL_REGISTRY_BLOCKED_IPS=

# Deny all registry downloads unless a resolved address matches
# CYRNEL_REGISTRY_ALLOWED_IPS. Truthy: 1 | true.
CYRNEL_BLOCK_ALL_REGISTRIES=false

# Default registry seeded at startup when the registries table is empty.
# Unset (or empty) = no seeding. Example: http://localhost:9372 (dev fixture).
# CYRNEL_DEFAULT_REGISTRY_URL=

# Comma-separated CIDR ranges allowed to carry registry credentials over
# plaintext http. Registry auth (api key / oauth2 client credentials) requires
# https unless the resolved address is loopback or matches this list.
# Examples:
#   CYRNEL_REGISTRY_AUTH_INSECURE_CIDRS=10.0.0.0/8
#   CYRNEL_REGISTRY_AUTH_INSECURE_CIDRS=192.168.1.0/24,fd00::/8
CYRNEL_REGISTRY_AUTH_INSECURE_CIDRS=

# Dev registry fixture (apps/api/scripts/dev-registry.ts, port 9372)
# advertises/enforces auth for end-to-end testing:
#   CYRNEL_DEV_REGISTRY_AUTH_MODE=none|apiKey|oauth2    (default none)
#   CYRNEL_DEV_REGISTRY_API_KEY=dev-registry-key
#   CYRNEL_DEV_REGISTRY_CLIENT_ID=dev-client
#   CYRNEL_DEV_REGISTRY_CLIENT_SECRET=dev-secret
#   CYRNEL_DEV_REGISTRY_TOKEN=dev-registry-token
#   CYRNEL_DEV_REGISTRY_TOKEN_EXPIRES_IN=3600
#   CYRNEL_DEV_REGISTRY_DRIFT_AUTH=0|1 (advertise pins that differ from what
#     the fixture enforces, to exercise the server's drift warning)

# RATE LIMITING
# If unset, rate limiting is disabled.
CYRNEL_RATE_LIMIT_MAX=
CYRNEL_RATE_LIMIT_WINDOW_MS=



# INBOUND ACCESS CONTROL
# Comma-separated CIDR ranges that are always allowed for inbound API access.
# Matching addresses bypass all other checks.
# Examples:
#   CYRNEL_ALLOWED_IPS=10.0.0.0/8
CYRNEL_ALLOWED_IPS=

# Comma-separated CIDR ranges that are always blocked for inbound API access.
# Blocked entries take precedence over allowed entries.
# Examples:
#   CYRNEL_BLOCKED_IPS=203.0.113.0/24
CYRNEL_BLOCKED_IPS=

# PROCESS & SANDBOX LIMITS
# Maximum number of in-memory active process records (default 1000).
# CYRNEL_MAX_ACTIVE_PROCESSES=1000

# Maximum number of idle in-memory process records before the least
# recently executed are unloaded automatically (unset = unlimited).
# Must be a positive integer (minimum 1); 0 and non-integer values are
# treated as unset/unlimited.
# CYRNEL_MAX_IDLE_PROCESSES=100

# Maximum code size in bytes for sandbox execution (default 102400).
# CYRNEL_MAX_CODE_SIZE_BYTES=102400

# Tool invocation timeout in ms (default 30000).
# CYRNEL_INVOKE_TIMEOUT_MS=30000

# Approval timeout in ms (default 300000). 0 is invalid and falls back to default; changing this never retroactively shifts in-flight deadlines.
# CYRNEL_APPROVAL_TIMEOUT_MS=300000
# Retention for terminal approval rows in ms (default 2592000000 = 30 days). 0 = keep forever.
# CYRNEL_APPROVAL_RETENTION_MS=2592000000
