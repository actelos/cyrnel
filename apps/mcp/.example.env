# Server
# One of: stdio | http. `stdio` is the standard MCP transport. `http` exposes
# an HTTP/SSE stream on MCP_HTTP_HOST:MCP_HTTP_PORT.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=9373

# Cyrnel API
# Base URL of the Cyrnel API the MCP server proxies tool calls to.
CYRNEL_API_URL=http://localhost:9371
# How long to wait for an API response before aborting.
CYRNEL_API_TIMEOUT_MS=30000

# AUTH
# Bearer token sent as `Authorization: Bearer <key>` on API calls.
# Leave blank if the API runs unauthenticated.
CYRNEL_API_KEY=

# APPROVALS
# How pending tool approvals are surfaced to MCP clients. The underlying
# approval and tool policy machinery is identical either way; this only
# decides how the MCP layer presents it.
#
# elicitation (default):
#   create_process / run_process with block=true drive the review themselves
#   over MCP elicitation (the client must advertise `elicitation: { form: {} }`),
#   so one logical tool call covers a process that hits any number of
#   approvals. Accepting runs the tool; declining or cancelling denies it and
#   the process resumes immediately.
#
# manual:
#   Approval management is exposed as the `list_pending_approvals`,
#   `approve_approval`, and `deny_approval` tools. Blocking calls return the
#   suspended process and its pending approval ids, and the model decides them
#   explicitly. Use this for clients that do not implement elicitation.
#
# Any other value fails startup.
CYRNEL_MCP_APPROVAL_METHOD=elicitation

# Logging
# NODE_ENV: set to "development" to enable pretty-printed logs (requires
# pino-pretty dev dependency). Omit or set to "production" for JSON lines.
NODE_ENV=production
# LOG_LEVEL: one of "fatal", "error", "warn", "info", "debug", "trace".
# Defaults to "info" in production, "debug" in development.
LOG_LEVEL=info
