# TRANSPORT
# One of: stdio | http. `stdio` is the standard MCP transport (server is
# launched as a subprocess by the client). `http` exposes an HTTP/SSE stream
# on MCP_HTTP_HOST:MCP_HTTP_PORT — useful for local debugging.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333

# Cyrnel API
# Base URL of the Cyrnel API the MCP server proxies tool calls to.
CYRNEL_API_URL=http://localhost:7687
# How long to wait for an API response before aborting.
CYRNEL_API_TIMEOUT_MS=30000

# AUTH
# Bearer token sent as `Authorization: Bearer <key>` on API calls.
# Leave blank if the API runs unauthenticated.
CYRNEL_API_KEY=
