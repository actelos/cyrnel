# Server
# One of: stdio | http. `stdio` is the standard MCP transport. `http` exposes
# an HTTP/SSE stream on MCP_HTTP_HOST:MCP_HTTP_PORT.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=9373

# Cyrnel API
# Base URL of the Cyrnel API the MCP server proxies tool calls to.
CYRNEL_API_URL=http://localhost:9371
# How long to wait for an API response before aborting.
CYRNEL_API_TIMEOUT_MS=30000

# AUTH
# Bearer token sent as `Authorization: Bearer <key>` on API calls.
# Leave blank if the API runs unauthenticated.
CYRNEL_API_KEY=

# Logging
# NODE_ENV: set to "development" to enable pretty-printed logs (requires
# pino-pretty dev dependency). Omit or set to "production" for JSON lines.
NODE_ENV=production
# LOG_LEVEL: one of "fatal", "error", "warn", "info", "debug", "trace".
# Defaults to "info" in production, "debug" in development.
LOG_LEVEL=info
