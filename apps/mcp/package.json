{
  "name": "@cyrnel/mcp",
  "version": "1.1.3",
  "description": "Cyrnel MCP server",
  "keywords": [
    "cyrnel",
    "ai",
    "mcp",
    "proxy",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/actelos/cyrnel.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/actelos/cyrnel/blob/main/apps/mcp/README.md",
  "author": "0x15ba88ff",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cyrnel-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastmcp": "^4.1.0",
    "ky": "^2.0.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "4.22.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.3"
}
