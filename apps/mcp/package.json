{
  "name": "@cyrnel/mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "Cyrnel MCP server",
  "keywords": [
    "cyrnel",
    "ai",
    "mcp",
    "proxy",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/actelos/cyrnel/blob/main/apps/mcp/README.md",
  "author": "0x15ba88ff",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "cyrnel-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastmcp": "^4.1.0",
    "ky": "^2.0.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^25.9.2",
    "pino-pretty": "^13.1.3",
    "tsx": "4.22.4",
    "typescript": "^6.0.3"
  }
}
