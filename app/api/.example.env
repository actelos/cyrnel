# Server
PORT=7687
SHUTDOWN_TIMEOUT_MS=10000

# Auth
# If unset, the API runs without API-key auth.
MCI_API_KEY=change-me

# Secrets (required for endpoints that encrypt/decrypt stored secrets)
# Must be base64 for exactly 32 bytes (AES-256-GCM key).
MCI_SECRETS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Database
# If set, overrides local sqlite file and in-memory test DB.
# Example (local file): MCI_DB_URL=file:./mci.db
# Example (libsql/turso): MCI_DB_URL=libsql://<host>?authToken=<token>
MCI_DB_URL=

# Used when `MCI_DB_URL` is not set (defaults to `.`).
# MCI_DATA_DIR=./app/api

# Runtime
# NODE_ENV=production

# Test-only flags (used by the API to detect test environment)
# VITEST=1
