{
  "name": "mci-api",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "express": "^5.2.1",
    "ipaddr.js": "^2.3.0",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "25.6.0",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
