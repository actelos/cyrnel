{
  "name": "@cyrnel/sdk",
  "version": "1.1.2",
  "description": "Cyrnel modules SDK",
  "keywords": [
    "cyrnel",
    "modules"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/actelos/cyrnel.git",
    "directory": "packages/libs/sdk"
  },
  "homepage": "https://actelos.mintlify.app/cyrnel/specs",
  "author": "0x15ba88ff",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.3"
}
