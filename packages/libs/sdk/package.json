{
  "name": "@cyrnel/sdk",
  "type": "module",
  "version": "1.0.0",
  "description": "Cyrnel modules SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cyrnel",
    "agents"
  ],
  "author": "Actelos",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
