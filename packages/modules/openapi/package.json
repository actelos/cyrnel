{
  "name": "@mci/openapi",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@mci/sdk": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.8.0",
    "openapi-types": "^12.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
