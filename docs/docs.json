{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Actelos",
  "colors": {
    "primary": "#a995c9",
    "light": "#8a79ab",
    "dark": "#a995c9"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "content/introduction",
                  "content/faq",
                  "content/comparison"
                ]
              },
              {
                "group": "Architecture",
                "pages": [
                  "content/architecture",
                  "content/transport",
                  "content/security"
                ]
              },
              {
                "group": "Concepts",
                "pages": [
                  "content/processes",
                  "content/services",
                  "content/tools",
                  {
                    "group": "Modules",
                    "pages": [
                      "content/modules",
                      "content/modules/adapters",
                      "content/modules/environments"
                    ]
                  }
                ]
              },
              {
                "group": "Built-in Modules",
                "pages": [
                  "content/builtins/openapi",
                  "content/builtins/typescript-ivm"
                ]
              }
            ]
          },
          {
            "tab": "Specification",
            "groups": [
              {
                "group": "Overview",
                "pages": ["spec/overview", "spec/types"]
              },
              {
                "group": "Module Interfaces",
                "pages": [
                  "spec/module",
                  "spec/adapter-module",
                  "spec/environment-module"
                ]
              },
              {
                "group": "Runtime Contracts",
                "pages": ["spec/bindings", "spec/execution"]
              },
              {
                "group": "Authoring",
                "pages": ["spec/writing-a-custom-module"]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "./openapi.json"
          }
        ]
      },
      {
        "anchor": "Blog",
        "icon": "newspaper",
        "href": "https://actelos.github.io/blog/"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": []
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/modelcontrolinterface"
    }
  },
  "description": "Actelos is an open AI lab focusing of giving models efficient and reliable agency.",
  "seo": {
    "indexing": "all"
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#f8f7fa",
      "dark": "#1a1823"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "latex": true,
    "eyebrows": "breadcrumbs"
  },
  "icons": {
    "library": "lucide"
  }
}
