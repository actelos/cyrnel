  "description": "Cyrnel is software that enables secure, fast, reliable, and efficient integration\nbetween LLM applications and external services.\n\nCyrnel is an interface that lets users plug in any service over any protocol with\nany standard and have models use it efficiently at low cost.\n\nRather than a USB-C for AI applications, think of cyrnel as a modular docking\nstation. Instead of expecting all devices to use USB-C ports, we have one\npowerful docking station that can connect to any port and communicate with any\nservice. If your port isn't on the existing docking station, just make an\nextension for it.",
  "seo": {
    "indexing": "all"
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#f8f7fa",
      "dark": "#1a1823"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "latex": true,
    "eyebrows": "breadcrumbs"
  },
  "icons": {
    "library": "lucide"
  },
  "redirects": [
    {
      "source": "/cyrnel/specs/:slug*",
      "destination": "/cyrnel/module-specs/:slug*"
    }
  ]
}
