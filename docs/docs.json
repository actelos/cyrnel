                      "cyrnel/docs/transport",
                      "cyrnel/docs/security"
                    ]
                  },
                  {
                    "group": "Concepts",
                    "pages": [
                      "cyrnel/docs/processes",
                      "cyrnel/docs/services",
                      "cyrnel/docs/tools",
                      "cyrnel/docs/pagination",
                      {
                        "group": "Modules",
                        "pages": [
