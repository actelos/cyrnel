{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": ["npx", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".mts", ".cts"],
      "env": {
        "NODE_OPTIONS": "--no-warnings"
      }
    },
    "typescriptreact": {
      "command": ["npx", "typescript-language-server", "--stdio"],
      "extensions": [".tsx"],
      "env": {
        "NODE_OPTIONS": "--no-warnings"
      }
    },
    "biome": {
      "command": ["npx", "@biomejs/biome", "lsp-proxy"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".json", ".jsonc"]
    }
  },
  "mcp": {
    "cyrnel": {
      "type": "local",
      "command": ["pnpm", "-C", "apps/mcp", "start"],
      "cwd": "apps/mcp",
      "enabled": true,
      "environment": {
        "MCP_TRANSPORT": "stdio"
      }
    }
  }
}
